---
import Layout from '../layouts/Layout.astro';
import { homeUrl } from '../lib/paths';

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} | Abogados Papus`} description={description} noindex={false}>
	<article class="pt-24 pb-24">
		<div class="mx-auto w-full max-w-3xl px-4 md:px-6">
			<a
				href={homeUrl}
				class="caption-1 inline-flex items-center gap-2 text-ink-soft transition duration-300 ease-base hover:text-accent"
			>
				← Volver al inicio
			</a>

			<h1 class="heading-2 mt-6 text-balance">{title}</h1>
			<p class="caption-2 mt-2 text-ink-soft">Última actualización: {updated}</p>

			<div class="mt-8 flex flex-col gap-6">
				<slot />
			</div>
		</div>
	</article>
</Layout>
