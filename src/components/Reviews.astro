---
import Rating from "./Rating.astro";
import { site, testimonials } from "../lib/site";
---

<section aria-labelledby="resenas-titulo" class="py-24">
	<div class="mx-auto w-full max-w-6xl px-4 md:px-6">
		<div
			class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between"
			data-reveal
		>
			<div class="max-w-[680px]">
				<p class="caption-1 text-ink-soft">Valoraciones de clientes</p>
				<h2 id="resenas-titulo" class="heading-2 mt-4 text-balance">
					Lo que cuentan quienes ya pasaron por el estudio.
				</h2>
			</div>
			<div class="flex flex-col gap-1">
				<p class="heading-4 text-ink">
					{
						site.rating.toLocaleString("es-AR", {
							minimumFractionDigits: 1,
						})
					} de 5
				</p>
				<p class="caption-2 text-ink-soft">
					Según {site.reviewCount} valoraciones de clientes.
				</p>
			</div>
		</div>

		<!-- <ul class="mt-12 grid gap-6 md:grid-cols-2"> -->
		<!-- Elfsight Google Reviews | Untitled Google Reviews -->
		<script src="https://elfsightcdn.com/platform.js" async></script>
		<div
			class="elfsight-app-dc27ac90-0bc4-4969-8a8c-c6cd5d199130"
			data-elfsight-app-lazy
		>
		</div>
		<!-- </ul> -->

		<p class="caption-5 mt-8 text-ink-soft">
			Valoraciones de clientes del estudio. Los resultados de cada caso
			dependen de sus circunstancias particulares.
		</p>
	</div>
</section>
