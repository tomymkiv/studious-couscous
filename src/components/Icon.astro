---
type IconName =
	| 'phone'
	| 'mail'
	| 'pin'
	| 'clock'
	| 'check'
	| 'arrow'
	| 'shield'
	| 'document'
	| 'calendar'
	| 'star'
	| 'star-outline';

interface Props {
	name: IconName;
	class?: string;
}

const { name, class: className = 'size-5' } = Astro.props;

const strokeIcons: Record<string, string[]> = {
	phone: [
		'M6.6 3.6h2.9l1.4 3.9-2 1.4a12.2 12.2 0 0 0 5.9 5.9l1.4-2 3.9 1.4v2.9a2 2 0 0 1-2.2 2A16.9 16.9 0 0 1 4.6 5.8a2 2 0 0 1 2-2.2Z',
	],
	mail: ['M3.5 6.5h17v11h-17z', 'm4 7.2 8 5.8 8-5.8'],
	pin: [
		'M12 21c0 0 7-6.1 7-11a7 7 0 1 0-14 0c0 4.9 7 11 7 11Z',
		'M12 12.2a2.2 2.2 0 1 0 0-4.4 2.2 2.2 0 0 0 0 4.4Z',
	],
	clock: ['M12 3.2a8.8 8.8 0 1 0 0 17.6 8.8 8.8 0 0 0 0-17.6Z', 'M12 7.4V12l3.1 2'],
	check: ['m4.8 12.4 4.6 4.6L19.2 7.2'],
	arrow: ['M4 12h15', 'm13 6 6 6-6 6'],
	shield: ['M12 3.2 4.6 6v6c0 4.5 3.2 7.6 7.4 9 4.2-1.4 7.4-4.5 7.4-9V6L12 3.2Z'],
	document: [
		'M6.5 3.5h7l4 4v13h-11z',
		'M13.5 3.5v4h4',
		'M9 12h6',
		'M9 15.5h6',
	],
	calendar: ['M4.5 6.5h15v13h-15z', 'M8 3.5v4', 'M16 3.5v4', 'M4.5 10.5h15'],
	'star-outline': [
		'm12 3.9 2.5 5.1 5.6.8-4.1 4 1 5.6-5-2.6-5 2.6 1-5.6-4.1-4 5.6-.8Z',
	],
};

const filledIcons: Record<string, string[]> = {
	star: ['m12 3.4 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.3-4.1 5.9-.9Z'],
};

const isFilled = name in filledIcons;
const paths = isFilled ? filledIcons[name] : strokeIcons[name];
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 24 24"
	fill={isFilled ? 'currentColor' : 'none'}
	stroke={isFilled ? 'none' : 'currentColor'}
	stroke-width="1.6"
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
	focusable="false"
>
	{paths.map((d) => <path d={d} />)}
</svg>
