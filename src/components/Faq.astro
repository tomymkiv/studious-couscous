---
import { faqs } from '../lib/site';
---

<section id="preguntas" class="border-y border-line bg-surface py-24">
	<div class="mx-auto w-full max-w-6xl px-4 md:px-6">
		<div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
			<div class="max-w-[680px] lg:sticky lg:top-24" data-reveal>
				<p class="caption-1 text-ink-soft">Antes de la primera reunión</p>
				<h2 class="heading-2 mt-4 text-balance">Preguntas frecuentes.</h2>
				<p class="body-3 mt-6 text-pretty text-ink-soft">
					Si su duda no aparece aquí, puede escribirnos. Le respondemos con una orientación general y,
					si el caso lo requiere, coordinamos una consulta.
				</p>
				<a
					href="/#consulta"
					class="btn-primary mt-8"
				>
					Solicitar consulta
				</a>
			</div>

			<ul class="flex flex-col gap-4">
				{
					faqs.map((faq) => (
						<li data-reveal>
							<details class="rounded-2xl border border-line bg-canvas px-6 py-4">
								<summary class="flex cursor-pointer items-center justify-between gap-4 py-2">
									<span class="title-3">{faq.question}</span>
									<span class="faq-icon shrink-0 text-accent" aria-hidden="true">
										<svg
											xmlns="http://www.w3.org/2000/svg"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											class="size-5"
										>
											<path d="M12 5v14M5 12h14" />
										</svg>
									</span>
								</summary>
								<p class="body-6 mt-2 pb-2 text-pretty text-ink-soft">{faq.answer}</p>
							</details>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>
