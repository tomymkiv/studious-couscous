---
import Logo from './Logo.astro';
import { navLinks, site } from '../lib/site';
import { homeUrl, withBase } from '../lib/paths';
---

<header class="fixed inset-x-0 top-0 z-50">
	<div class="px-4 pt-4">
		<div
			class="relative z-50 mx-auto flex w-full max-w-6xl items-center justify-between gap-4 rounded-2xl border border-line bg-surface/80 px-3 py-2 shadow-sm backdrop-blur-xl"
		>
			<a
				href={homeUrl}
				class="flex items-center gap-2 rounded-lg py-1 pr-2 pl-1 transition duration-300 ease-base hover:bg-accent-soft"
				aria-label={`${site.name}, ir al inicio`}
			>
				<Logo class="size-8 text-accent" />
				<span class="flex flex-col">
					<span class="title-3">{site.name}</span>
					<span class="caption-5 text-ink-soft">Estudio jurídico</span>
				</span>
			</a>

			<nav aria-label="Navegación principal" class="hidden items-center gap-1 lg:flex">
				{
					navLinks.map((link) => (
						<a href={withBase(link.href)} data-nav-section={link.section} class="nav-link">
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="flex items-center gap-2">
				<a href={withBase('/#consulta')} class="btn-primary btn-sm hidden sm:inline-flex">
					Solicitar consulta
				</a>
				<button
					type="button"
					data-menu-toggle
					data-open="false"
					aria-expanded="false"
					aria-controls="menu-movil"
					aria-label="Abrir menú"
					class="relative inline-flex size-10 items-center justify-center rounded-lg border border-line bg-surface transition duration-300 ease-base hover:bg-accent-soft active:scale-[0.98] lg:hidden"
				>
					<span class="menu-icon" aria-hidden="true">
						<span class="menu-bar menu-bar-top"></span>
						<span class="menu-bar menu-bar-mid"></span>
						<span class="menu-bar menu-bar-bottom"></span>
					</span>
				</button>
			</div>
		</div>
	</div>

	<div
		id="menu-movil"
		data-menu-panel
		data-open="false"
		class="mobile-menu fixed inset-0 z-40 overflow-y-auto bg-canvas/95 backdrop-blur-2xl lg:hidden"
	>
		<div class="flex min-h-full flex-col px-6 pt-24 pb-8">
			<nav aria-label="Navegación móvil" class="mt-6 flex flex-col gap-1">
				{
					navLinks.map((link, index) => (
						<a
							href={withBase(link.href)}
							data-menu-link
							class="menu-link rounded-lg px-3 py-3 text-xl font-medium text-ink transition duration-300 ease-base hover:bg-accent-soft"
							style={`--i: ${index}`}
						>
							{link.label}
						</a>
					))
				}
			</nav>

			<div class="mt-auto flex flex-col gap-4 pt-12">
				<a href={withBase('/#consulta')} data-menu-link class="btn-primary w-full">Solicitar consulta</a>
				<div class="flex flex-col gap-2">
					<a
						href={`tel:${site.phone}`}
						class="caption-1 text-ink transition duration-300 ease-base hover:text-accent"
					>
						{site.phoneDisplay}
					</a>
					<a
						href={`mailto:${site.email}`}
						class="caption-1 text-ink transition duration-300 ease-base hover:text-accent"
					>
						{site.email}
					</a>
					<p class="caption-2 text-ink-soft">{site.address}, {site.addressCity}</p>
				</div>
			</div>
		</div>
	</div>
</header>
